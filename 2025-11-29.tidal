(setcps 0.48)

do
  let pat = "{1 0/3 [1 0?]/2 ~ 0/4 1/2 ~ ~ <1 ~ 1 0> 1 ~ ~ 0 <1 0 ~ 1> ~ ~}%12"
  let pat2 = "{0/2 1 <1 ~ ~> 0? 1/2 1/5 0 ~ ~ ~ 1 0}%12"
  let x = gain pat
  let y = gain (inverse <$> pat)
  let z = gain pat2
  let w = gain (inverse <$> pat2)
  d1
    $ every 13 (stut' 4 (1/8) (|* gain (sinosc 1 0.75 6.75)) . (|+ speed (randosc 2.25 0.4)))
    $ every 11 (within (0.75, 1) (jux (rot "<-1 0>/8") . (|* sus (sinosc 0.1 1 3))))
    $ every 4 (within (0.5, 0.75) (stutWith "<5 4 3>" (1/8) (|+ accelerate (range (-0.03) 1.2 sine))))
    $ within (0, 0.25) (stutWith "<4 2 2 5>" (1/4) (|* sus (range 0.25 0.75 $ slow 1.33 sine)) . (|* gain 0.65))
    $ stack [
      (x |+ s "mbd:9" |+ sus (range 0.5 0.125 $ slow 3 saw) |+ up "{-14 0 2 -8 -4 12}")
      , (z |+ s "<mst:6 msn:4 ~>" |+ sus (range 0.01 0.075 $ slow 3 sine) |+ accelerate (range 0.3 (-0.04) $ slow 6.5 sine))
      , (y |+ s "mhh:2" |+ sus (range 0.05 0.125 $ slow 0.65 sine) |+ up "7 0 5 0 3 -4 12")
      , (w |+ s "<msn2:24 mcp cusn:14>" |+ cutoff "<2200 1200>" |+ sus (range 0.05 0.075 $ slow 0.65 sine) |+ up "{-7 <24 -15> -23 <-6 -4> <15 -12>}")
    ] 
    |+ mGain
    |+ shape 0.2
    -- |+ orbit 1
    |+ slowPanR 3

d9 
  $ degradeBy 0.25
  $ off "<0.125 0.5 0.075>" (|+ up "<5 7 -5>") . (rot "<0 1 -2>")
  $ n (scale "hexDorian" "{[~ -2/2]/8 <~ -5 ~ 7> ~ [~ -5/4]*2 ~ <0 -8 ~ ~> ~ ~}%12") 
  |+ s "[midiout]" 
  |+ midichan 0 

d10
  $ s "[midiout]*4" 
  |+ n (scale "hexDorian" "{[~ -2/2]/8 <~ -5 ~ 7> ~ [~ -5/4]*2 ~ <0 -8 ~ ~> ~ ~}%12") 
  |+ midichan 1 

-- pad section
d4
$ up (scale "hexDorian" "<[0, 3, -7, 6] [4, 7, -10, 13]>/2" - 14)
|+ s "pad2:9"
|+ n 6
|+ sus 6
|+ fshift (range 8 (-4) $ slow 3.333 sine)
|+ cutoff 2100
-- |+ cutoff 1100
|+ gain 0.95

d7 silence

d2
$ mask "[t f f t]/2"
$ off 0.5 (0.25 ~>) . (iter 2)
$ up (scale "hexPhrygian(5,8)" "<3 1 5 3>" - 2)
|+ s "cub:1"
|+ chorus 0.002
|+ room 0.3
|+ sus "0.13 0.2"
|+ gain 1.0

d4
$ mask "t t t <t f>"
$ up (scale "hexDorian" "{0 4 6 -9 16 9 0 15 3 16 1 0 3 18 6 -9}" - 2)
|+ s "<ml:6 ml:6 ml4:3>"
|+ n "{0 5 2 1 -1}"
|+ sus (range 0.92 0.35 $ slow 2.5 sine)
|+ coarse "{2 2 4 <2 12> 4 <12 2>}%7"
|+ convn "<0 0.3 0> 0 <0.4 0 0.3>"
-- |+ n "23 18" |* sus 0.76
|+ mGain
|+ slowPanS 2

d5
$ mask "t [f t] [f t f t] [f t]*2"
$ every 2 (rot 2) . (rev)
$ every 3 (|+ convn 0.4)
$ sometimes (|+ wah 0.04)
$ up (scale "iraq" "{0 7 ~ 15 2 ~ <3 1> 0 ~ 8 ~ 21 1 -25 12}%12" + "<3 15 -2>/2" + 12)
|+ sus "{0.05 0.01 0.075 0.03 0.04 0.51 0.075 0.1 0.5 0.75 0.08}%32"
|+ coarse "[4 2 12 8 24 12 2]*2"
|+ crush "{4 12 8 12 8}%7"
|+ s "ml5:5 ml:29"
|+ cutoff "[4240 12450 1800 9500 1290]*4"
|+ vowel "a e o i"
|+ slowPanR 0.4
|+ mGain

d7
$ up (scale "hexDorian" "{~ [~ 3] [4 8 ~] ~ ~ ~ ~ ~ 10 5 -2 <0 -1>}" - 2)
-- |+ s "ml6:5"
|+ s "ml:23"
|+ coarse 8
|+ sus (range 0.25 0.14 $ slow 4 sine)
|* sus  "1 0.75 0.4 0.8 0.765 0.999 0.8 1 0.75"
-- |+ room 0.2
|+ mGain

do
  d1 silence
  d2 silence
  d8 silence

d7 silence
