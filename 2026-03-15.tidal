setcps (132/120/2)

-- d1
-- $ slow 16
-- $ (0.5<~)
-- $ sometimes (off 0.3333 (|+| disv "0.0125" "2"))
-- $ sometimes (striate 3)
-- $ sound "mpd3:19*3"
-- |+ n "<9 2 2 0>*3"
-- |+ begin (range 0.125 0.5 sine)
-- |+ up (slow 3 $ "<[0,5] [2,7,14] [-7,0] [0,-3] [-5, 3]>"*2 - 12)
-- |> speed 0.5
-- |+ sus 8
-- |+ cut "<1 4>"
-- |* gain 0.1
-- |+ convn "0.2"
-- |+ mGain

d2 silence

do
   let 
    pat = "{[~ 0]/2 ~ ~ ~ 1 [1? 0/6]/2 ~ ~ <~ 0> ~ [1 0/3]/2 <0/4 ~> ~ 0 ~ ~}%16"
    pat2 = "{~ 0 1/2 ~ 0/4 ~ 0 1 1/3 0 ~ 1/2 [~ 0]/4 ~ ~ ~}%16"
   d2
    $ ((10/16)<~)
    $ every 4 ((within (0, 0.5)) (msvoB 0)) . (within (0.5, 0.75) (|+ binshfR))
    $ every 9 (within (0.25, 0.65) (stutWith "<3 2 3 6>" (1/16) (|+ accelerate (range 0.3 (-1.24) $ slow 0.75 sine))))
    $ every 10 (within (0.5, 0.75) (|> mGrav) . (iter 2))
    $ sometimes (within (0.5, 0.6) (iter 1))
    $ sometimesBy 0.125 (off "<0.75 -0.75>" (|* speed "1 -1.5 1.75") . (|* gain 0.5))
    $ stack [
      mask "t [t [f t] t]" $ gain pat2 |+| sound "mhh:2" |+ cutoff (range 1300 7000 $ slow 3 sine) |+ accelerate "{-0.03 0.5 -0.16 -0.3 0.3 <0 0 0.02 -0.8>}"|+ sus "{0.125 0.2 0.35 0.125 0.08 0.02 0.09}%16"
      , gain (inverse <$> pat) |+| s "mbd:10" |+ up "{-3 4 -4 2 -4 -5 -7 0 4}%12" |+ accelerate "{0.04 -0.04 -0.4 0.03}" |+ sus "0.03 0.99 0.8 0.13 0.75 0.8"
      , (0.25<~) $ gain pat |+| sound "[moe1  [moe1, ~] moe2]/3" |+ up "{<0 -5> 0 8 -3 <8 4 6 -24> -5 4 -2}%12" |* gain 0.75
      , mask "f t [t f]/2 f" $ gain (inverse <$> pat2) |+| s "~ msn:16" |+ sus (range 0.025 0.25 $ slow 3 sine)
      ]
      |* speed (range 1.08 0.85 $ slow 4 sine)
      -- |+| mDefault
      |+ mGain
      |+ cutoff (range 6200 800 $ slow 3.75 sine)
      |+ slowPanS 4

d3
$ slow 2
$ (0.25~>)
$ every 3  (|+ dist "0.3 0.4 0.1 0.0 0.4")
$ every 5  (|+ binshfS "0.3 0.4 0.1 0.0 0.4")
$ up (scale "hexDorian" "[-2,5,9](<1 2 3>,16)" + "<0 1 -3>/2" -2)
|+ s "cul:5"
|+ sus (range 0.125 0.25 $ slow 0.3 sine)
|+ room 0.2
|+ hpf 800
|+ coarse 4
|+ shape 0.2
|+ convn (range 0.03 0.2 $ slow 3 sine)
|+ cutoff (range 1290 5250 $ slow 3 sine)
|+ gain 1.1

d4
$ every 5 (|+ dist "0.3 0.4 0.1 0.0 0.4")
$ mask "<t t [t f]>"
$ (0.45~>)
-- $ up (scale "hexDorian" ("~ [-2 5 9]*2 ~ [-4, 5] ~ 7 ~ [3 8 0 4]*2" - 18))
$ up (scale "hexDorian" "[-2,5,9](<1 2 1>,16)" + "<0 1 -3>/2" -2)
|+ s "<ml:4 ml:2 mwb:11>"
|+ sus (range 0.025 0.126 $ slow 8 sine)
|+ room 0.2
|+ cutoff (range 9000 1250 $ slow 3 sine)
|+ mGain

d9 
$ slow 1.5
$ (0.125<~)
$ (off "0.125 0.25" (|+ up "<-7 5>") . (|* sus 0.5))
$ slow 2 (scale "hexDorian" ("{~ [-4 , 0, <6/3 2>] -5*2 ~ [-9 [< 0 -2>, 2]/2, -3*2] ~ -2/2 ~ 14 ~ ~ ~ 7/2 ~ ~}%16" + "<0 3 2>" + 2))
|+ s "[midiout]" 
|+ midichan 0 
|+ sus "<0.5 0.5 0.25>  0.03 0.05 <0.45 1.125 0.8> 0.4 0.5 9 5 <0.125 0.45 0.255>"

do
  d8 $ "midiout*24" |+ ccv (range 87 66 $ density (slow 1.5 $ "{2 1 0.5 1 0.74 1}%8") $ slow 2 sine) |+ ccn 5 |+ midichan 0
  d5 $ "midiout*24" |+ ccv (range 27 120 $ density "0.75 2.5 0.125 0.75 2" $ slow 1.75 sine) |+ ccn 7 |+ midichan 0
  d6 $ "midiout*25" |+ ccv (range 37 86 $ density "0.2 0.1 1 0.75" $ slow 8 sine) |+ ccn 8 |+ midichan 0
  d11 $ "midiout*16" |+ ccv (range 67 16 $ density "1" $ slow 8 sine) |+ ccn 9 |+ midichan 0



d5 silence

hush


----------- anothor song
d8
$ up (scale "hexDorian" "-5/4 8/2 <~ [-4 2]> <~ 9> ~ ~ <~ 15/2> ~ ~ ~" - 10)
|+ s "ml2:32"
|+ sus (range 0.1 0.06 $ slow 4 sine)
|+ binscr (range 0.02 0.5 $ slow 5 sine)
|+ cutoff (range 7000 1250 $ slow 2.5 sine)
|+ coarse "<2 2 4 4 4 4 8 8 8>"
|* speed 0.80
|+ pan (-0.57)
|+ mGain

d7
$ slow 4
$ up (scale "hexDorian" "~ ~ ~ 17 ~ <5 -1> ~ 0 ~ [0 -4 5] ~ ~" + "<1 -2>")
|+ s "{cub:7 <cub:10 cub:9> cub:5}%8"
|+ sus (range 0.35 0.16 $ slow 6 sine)
-- |+ coarse 4
|+ cutoff (range 5000 150 $ slow 0.72 sine)
|+ gain 1.0


d9 
$ (off "<0.25 0.75>" (|+ up "<14 -5>") . (|+ sus 0.125))
$ slow 3 (scale "hexDorian" (iter 1 $ "[-5 ,0, <8 5>] ~ ~ [<0 8 6>, 2] ~ ~ 5 ~ ~" + "<0 -3 2 4>" + 2))
|+ s "[midiout]" 
|+ midichan 0 
|+ sus "<0.25 0.75 0.125> 0.5 0.25"

do
  d4 $ "midiout*24" |+ ccv (range 117 56 $ density (slow 4 $ "{2 1 0.5 1}%4") $ slow 2 sine) |+ ccn 5 |+ midichan 0
  d5 $ "midiout*24" |+ ccv (range 27 120 $ density "0.75 2.5 0.125 0.75 2" $ slow 1.75 sine) |+ ccn 7 |+ midichan 0
  d6 $ "midiout*25" |+ ccv (range 87 26 $ density "2 1 1 4" $ slow 8 sine) |+ ccn 8 |+ midichan 0

d10 
$ (off "<0.25 0.75>" (|+ up "<14 -5>") . (|+ sus 0.125))
$ (scale "hexDorian" (iter 1 $ "[-5 ,0, <8 5>] ~ ~ [<0 8 6>, 2] ~ ~ 5 ~ ~" + "<0 -3 2 4>" + 12))
|+ s "[midiout]" 
|+ midichan 0
|+ sus "<0.25 0.75 0.125> 0.5 0.25"

do
   let 
    pat = "{1 0*2 1/3 0 0/2 ~ ~ [~ 0/3]/4 1 ~ 1/4 1*2 0 1/2 ~ ~ 0 ~}%16"
    pat2 = "{0 1/2 ~ 0 1/4 0/3 <~ 0*2 1 1>*2 ~ [0 1 ~ 0*2]/4}%16"
   d2
    $ ((6/16)<~)
    -- $ degradeBy 0.5
    $ every 4 (within (0.75, 1) (|+ binshfR))
    $ every 10 (within (0.5, 1) (|> mGrav))
    $ slow "3 <1.5 3> 1.5"
    $ sometimes (within (0.5, 0.75) (stutWith 4 (1/16) (|+ accelerate (range (-0.6) (-0.03) $ slow 0.75 sine))))
    $ sometimesBy 0.5 (off "<0.125 0.75>" (|+ speed (slow 0.25 $ "0.3 -0.5 0.75")) . (|+ coarse "2 4 <8 12 8> 2 8 4"))
    $ stack [
      mask "t [[f t] [t f f] t]/3" $ gain pat2 |+| sound "mst:14" |+ cutoff (range 1300 7000 $ slow 3 sine) |+ accelerate "{-0.03 0.05 -0.16 -0.03 0.3 <0 0 0.02 -1.8>}"|+ sus "{0.125 0.2 0.35 0.125 0.08 0.02 0.09}%16"
      , mask "t <f t> <t f>" $ gain pat2 |+| s "mbd:5" |+ up "{-3 4 -4 2 -4 -5 -7 0 4}%12" |+ accelerate "{0.04 -0.04 -0.4 0.03}"
      , (0.125~>) $ gain pat |+ sound "[moe2/2 [moe1, mnz:4/8] moe1]/3" |+ sus "{0.02 0.5 0.07 0.125 0.5 0.75}" |+ up "{<0 -5> 0 8 -3 <8 4 6 -24> -5 4 -2}%12"  |+ cut 1 |* gain 0.4
      -- , mask "t [t f] f <f f t>" $ gain (inverse <$> pat2) |+| s "msn2:5 msn:15" |+ sus (range 0.25 0.95 $ slow 3 sine) |> gain 0.5
      , mask "t f <[t f]*2 [t f f]*2>"$ gain pat2 |+ s "<msn:6 ml:34/2>" |+ up (scale "hexDorian" "11 0 <9 4 5> <2 -3> -7 -6" + 2) |+ sus 0.125 |* gain 0.5
      ]
      -- |+| mDefault
      |+ mGain
      |+ slowPanR 4

d2 silence

d10 silence
