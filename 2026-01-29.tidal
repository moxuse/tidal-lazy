
do
  let pat = "{<~ 1> ~ ~ 0 ~ [1 ~] 0/2 ~ 1/2 [1 [~ 0/2]]/2 ~ ~ 1/3 <0 1> ~ ~}%5"
  let pat2 = "{1/2 ~ [~ 1 ~ 0]/2 <~ ~1> ~ ~ [~ 0, 1/3 ~]/2 1? [~ 0? 1 ~]/4 ~ 0/2 ~ ~ ~ 1/3 ~}%9"
  let x = gain pat
  let w = gain (inverse <$> pat)
  let y = gain pat2
  let z = gain (inverse <$> pat2)
  d1
    $ every 2 (within (0, 0.5) (stutWith "<2 3 4>" (1/"<16 6>") (|+ accelerate (range 0.04 (-0.6) sine))))
    $ every 7 (within (0.25, 0.5) (0.125~>) . (|+ coarse "2 8 4 2 12 8 4 2"))
    $ every 3 (within (0.5,0.75) (iter 1) . (|+ mfDel' "0.2 0 0 0.04 0.05 0.5"))
    $ stack [
      x |+ s "mhh" |+ n "0 10 1 0 0 0" |+ sus (range 0.05 0.35 $ slow 7 sine) |+ cutoff (range 4000 1200 $ slow 3 sine)|+ nudge "[0, 0.01]*2"
      , y |+ s "mbd:17" |+ sus (range 0.25 0.05 $ slow 5 sine) |+ shape 0.2 |+ accelerate "0 -0.3 -0.03 0.5"
      , w |+ s "msn2:3" |+ sus (range 0.025 0.25 $ slow 4 sine) |+ slowPanR 4
      , z |+ s "mst:9" |+ n "0 0 0 <0 -2> 0 2" |+ shape 0.2 |* gain (slow 3 (range 0.3 0.8 sine))
      , degradeBy 0.45 $ y |+ s "mwb2:5?" |+ slowSpeedR 3 |+ wah 0.03 |+ hpf 200 |+ sus 0.9
    ]
    |+ mGrav
    |+ slowSpeedR 3
    |+ accelerate "{0 -0.05 [0 0 -0.03] 0.05 -1 0 0.0 <0  0.2> 0}%8"
    |+ slowPanS 2
    |+ cps (128/120/2)

-- bass
d3
$ up (scale "hexDorian" "~ [<-2 ~>] 1 [~ <0 ~>] ~ 5 ~ ~ [~ <6 3>] ~ -6 ~ ~ ~ <0 ~> ~")
|+ s "mb:14"
|+ sus "0.125 0.05 0.075 0.25 0.6"
|+ mGain

d2
$ slow 2
$ every 3 (0.25~>)
$ stack [
  (degradeBy 0.45 $ s "knz:24(<2 3>,8)" |+ wah 0.02)
  , ((0.125~>) $ s "mnz:15(2,8)" |> sus 1.125 |+ speed "<0.65 0.95>/2" |> cutoff 1230 |+ vowel "<a e i>" |+ n "<0 -3>/4")
]
|+ sus (range 0.35 0.65 $ slow 3 saw)
|+ up "<-1 4 -5 -3>"
|+ cutoff (range 400 4500 $ slow 6.75 sine)
|+ dist 0.08
|+ slowPanR 4
|+ begin (range 0.025 0.66 $ slow 3 sine)
|+ speed (choose [-0.35, 0.4, 0.75, 0.99, -0.75])
|+ room 0.2
|+ mGain

-- pad
d6
$ slow 2
$ up (scale "hexDorian" "[-2,0,3,7,21]" + "<0 5 2 7>")
|+ s "pad2:8"
|+ mGain
|+ cutoff (range 600 3000 $ slow 4 sine)
|+ room 0.4

d1 silence

scaleList

