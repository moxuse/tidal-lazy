setcps 0.53

do
  let pat = "<0*2 0> 1 <1 ~> [~ 0]/2 [~ 1] 0 <~ 1 0> <1 0 ~>"
  -- let pat = "1 <0 ~> ~ [~ 0] ~ <~ 1 ~> <1*2 ~ ~> ~"
  let x = gain pat
  let y = gain (inverse <$> pat)
  d1
    $ every 4 (within (0.4, 0.75) (0.125~>) . (rev) . (density "<2 0.5>"))
    $ stack [
      (x |+ s "mhh:5" |+ slowSpeedR 3)
      , (y |+ s "mbd:5")
      , (mask "f t <t f> t t" $ x |+ s "mst:8" |+ slowPanS 2 |+ n "<0 7>")
    ]
    |+ slide "{50 0.004 1200 0.75 3 0.125 1000}%12"
    |+ mGain
    |+ slowPanR 4
    |+ ring "{1 0.5 0.87 0 0.4 0.3}%8"
    |+ ringf "[4 80 <140 70> 0 8 10]*2"
    |+ room "0.03 0 0.2 0 0.05"
    |+ mfDel' "{0.8 0 0 0.75 0 0.65}%6"
    |+ n "0 8 28"
    |+ up "{2 5 [7 0]*2 [5 -5]*2 10 0}" 
    |+ sus "{[0.75 0.85]*2 [0.25 0.75]*2 [<0.5 1> 1]*2}%8"
    |+ accelerate "{-0.01 0 <-0.08 0.5> -0.25 0 <-0.1 0> -0.04}"
    |* speed "{[1.75 -0.75]*2 [0.85 1]*2 [2 0.75]*2 3/5}%8"

d3
  $ s "~ mbd:3"
  |+ mGain
  |+ orbit 1

d2
  $ within (0, 0.5) (off 0.125 (|+ up "5 -1 7 -2 0 0"))
  $ slow 2
  -- $ every 2 (degradeBy 0.5)
  -- $ s "ml:5(4,16)"
  $ s "[ml:5(8,16) ml4:10(<8 4>,16)]/2"
  |+ sus "{[0.75 0.85]*2 [2 0.75]*2 [0.5 1]*2}%6"
  |+ coarse "{8 4 8 12 2 8}%8"
  |+ shape 0.3
  |+ wah "{0.03 0 0.05 0 0.1}%6"
  |+ squiz "[1 2]/2"
  |+ cutoff 1800
  |+ up (scale "ionian" "[0 4 11, -2 -4 12, 5 0] [15 5, 3 8] -3" - "<0 3 12 7>" - "<0 -12 -7>")
  |+ speed "{-1 2 1 -1.125 -1 1 2}%4"
  |+ room 0.3
  |+ slowPanS 5
  |+ mGain


d1 silence
