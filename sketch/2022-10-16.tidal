setcps (148/120/2)

do
  let pat = "{0 [1*2 ~]/2 ~ 1 [0 [~ 1]]/2 1 [~ 1] ~}%16"
  let pat2 = "{1 ~ [~ 1 ~ 0]/4 1*2 0 [~ 0, 1 ~]/2 0 [~ 0 1]/3}%8"
  let x = gain pat
  let y = gain pat2
  let z = gain (inverse <$> pat2)
  d1
    $ every 2 (msvoB 0)
    $ every 9 (within (0.25, 0.5) (|+ coarse "4 [8 2] 2 [8 2 12]*2"))
    $ every 12 (within (0.5, 0.8) (rev) . (|+ mfDel' 0.25) . (|+ crush "0 2 8 6 8") . (|* gain 0.5))
    $ stack [
      x |+ s "mhh:1*4" |+ up "1 [5 0 0] 5 [5 0 0] 0 [0 13]*2" |+ nudge "[0, 0.01]*2"
      , y |+ s "mbd:16" |+ sus 0.75 |+ accelerate "1 -0.3 0 -3 0.5"
      , y |+ s "msn2:4" + n "<0 1>" |+ room 0.3 |+ sus "{0.25 0.03 0.43 1 0.75}" |+ accelerate "[-1 10 -0.03] -0.04 -0.5"
      , degradeBy 0.95 $ x |+ s "mwb:5" |+ slowSpeedR 2
      , z |+ s "mst:6" |+ shape 0.3 |* gain (slow 3 (range 0.3 0.8 sine))
      -- , x |+ "~ ~ ~ dig2"
      -- , y |+ "~ ~ ~ dig3"
      -- , x |+ "dig4 ~ dig4 ~"
      , degradeBy 0.9 $ y |+ s "mwb2:3?" |+ slowSpeedR 3 |+ wah 0.15 |+ hpf 200 |+ sus 0.9
    ]
    |+ mGain
    |+ accelerate "{1.2 1 -0.05 [0 -1 -0.03] 1 -1 4 0.03 4 0.2 3}%12"
    |+ slowPanR 4


d4 $ slow 32 $ s "sync"

