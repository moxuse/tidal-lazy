-- d5 $ s "rmsn(22,24)"|+ mGain |+ slowPanR 3 |+ coarse 4 |+ up (scale "hexDorian" "-4 5 6 12") 

-- d3 $ s "mgut(7,16)" |+ sus 1 |+ mGain |+ up (scale "hexDorian" "[1, 2, 12]*3 ~ ~") 

d7 $ "ml3:9(1,16)" |+ triode 0.3 |+ sus 0.85 |+ fshift (range 80 1200 $ slow 1.75 saw) |+ up (scale "dorian" "[0 3 -16]") |+ mGain

d8 $ s "rmsn(3,8)" |+ sus 0.1 |+ room 0.3 |+ mGain |+ up (scale "dorian" "[4, 5, -12]") 

do
  let pat = "{~ ~ ~ ~ 0 ~ ~ 1/6 0/2 ~ ~ ~ ~ 1/3 ~ ~ ~ ~ ~ ~}%16"
  let pat2 = "{~ <0 1 ~> ~ ~ ~ 0/2 ~ ~ 1 ~ ~ 1/4 0/3 ~ ~ ~ ~ ~}%16"
  let x = gain pat
  let y = gain (inverse <$> pat)
  let w = gain ((0.125<~) $ pat2)
  let z = gain (0.5 * ((0.125<~) $ (inverse <$> pat2)))
  d1
    $ mask "t f <t f> t"
    $ every 2 (stutWith "<3 5 6>" (1/12) (|* gain (range 0.025 1 $ slow 1.3 sine)))
    $ every 9 (stutWith "<4 2 3 5>" (1/8) rev . (|* end (range 0.25 1 $ slow 0.3 sine)) . (gap 3))
    $ stack[
      -- (y |+ s "cubd:4" |+ sus (range 0.075 0.65 $ slow 4 sine))
      (y |+ s "mbd:6" |+ sus (range 0.075 0.65 $ slow 4 sine))
    , (x |+ s "ksn:14" |+ sus (range 0.224 0.05 $ slow 3 sine) |+ up "34 -5 -12 12 0 -25" |+ hpf 4000)
      , (w |+ s "cubd:5" |+ sus (range 0.02 0.08 $ slow 5 sine))
      , (z |+ s "msn2:15" |+ sus (range 0.04 0.02 $ slow 3 sine))
    ]
    |+ room 0.1
    |+ slowPanR 2
    |+ mGain
    |+ slowSpeedR 3

d6 $ s "madd(5,<16 16 18>)" |+ up "[<33 -24 -13 19> -12 0 -24 -8]*5" |+ sus (range 0.12 "1.2 0.4 0.8 1.5" $ slow "<1.75 0.5 0.8>" sine) |+ slowPanS 4 |+ dist "0.1 0.2 0 0 0 0.2" |+ mGain

-- pad minor
d6 $ slow 2 $ s "pad:4" |+ sus 4.25 |+ loop 1 |+ up (scale "hexDorian" "[-7,-5]") |+ vowel "<a e o>"

d5 $ s "mst(4,9)" |+ n "2 5 0 17" |+ throp "{0 0 0 3 10 5 0 0}"|+ room 0.3

d6 silence

hush

d9 $ slow 1 $ every 2 (stutWith "<3 5 6>" (1/12) (|+ accelerate (range 0.1 (-0.2) $ slow 1.25 sine)) . (|+ sus (range 0.12 0.46 sine)))  
$ n (scale "hexDorian" "[-5, 4 -5/2, 0, 8] 7 ~ -5/4 [0, 2, 5] 6/8 ~ ~ [0/3, 5/3] -8 ~") |+ s "[midiout]" |+ midichan 0 |* sus "0.5 0.1 0.75 0.8" |+ room 0.1

d2 $ s "midiout*64" |+ ccv (range 70 32 $ density "1 0.2 0.75 [2 0.25 0.1] 0.1 0.03" sine) |+ ccn 1 |+ midichan 0

d3 $ s "midiout*32" |+ ccv (range 97 19 $ density "2 0.25 [3 0.4 0.3] 0.25" $ slow 4 saw) |+ ccn 2 |+ midichan 0

d4 $ s "midiout*16 midiout*10" |+ ccv (range 15 97 $ density "2 0.25 <5 0.1 0.4> [3 0.25 0.25]/3" $ slow 3 sine) |+ ccn 3 |+ midichan 0

-- pad
d6 $ rev $ up (scale "hexDorian" "[0,3,6,9]" - 12) |+ s "mpd:11" |+ gain 1.0 |+ cutoff 600 |+ room 0.4

d2 silence
d4 silence 
d3 silence

d9 silence
