setcps (132/120/2)

do
  let pat = "{0 1 [~ 1]/2 <1 0> <1 0 ~> <[1 ~]/2 ~> 0 <0 0 ~ 1> [1 0]/2 0 ~ 0 1 ~}%16"
  let x =  gain pat
  let y =  gain (inverse <$> pat)
  d1 
    $ every 7 (within (0.125, 0.5) (stut' 6 (1/128) (|* speed "1 [0.86 2 0.75]/3 2.9 2 <4 0.9 8>") . (|* sus (density 3 (range 0.0025 0.125 sine))) . (|+ coarse "4 8 2 4"))) 
    $ every 4 (within (0, 0.25) (stut' 5 (1/32) (|+ gain (range 0.47 1.0 sine)) . (|+ mfDel' (range 0.05 0.5 sine)) . (|* sus (density 2 (range 0.0125 0.95 sine))))) 
    $ every 11 (within (0.5, 1) (stut' 3 (1/16) (|+ accelerate "-0.3 0.5 0.04 -0.28") . (|+ binscr "<0.4 0.4 0.1 0.2>") . (|* sus 0.075) . (|+ vowel "[a e o]*2"))) 
    $ stack [ 
      (x  |+ s "mbd:9")
      , (y  |+ s "[mhh2:6 mhh:8*2]/4" |+ n "[6 -5]*3")
      , (s "[mhh2:19*4 knz:5*2 msn2:12*2 cub:5]/4")
    , (s "gtrig*8")
      ]
    |+ mGain
    |* gain"[0.45 0.65 1]*4"
    |+ slowSpeedR 3
    |+ slowPanS 4
    |+ room "0 [0 0.04]/3 <0.05 0 0> [<0 0.02 0 0> 0]"
    |+ up "0 <0 6 0> 6 0 -4 0"
    |+ pipe "{0 90? 0 0 [0 90]/4 0}%8"


