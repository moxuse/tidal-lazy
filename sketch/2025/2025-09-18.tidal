(setcps (140/120/2))

stutB s = sometimesBy 0.6 (stutWith "<3 2>" (1/8) (|> end (range 0.25 1 $ slow 0.35 sine)) . (|* gain (range 1 0.25 sine))) $ s

do
  let pat = "{0 ~ ~ 1 ~ ~ ~ ~ 0/2 1? ~ ~ [1 ~ 0 1?]/4 0 1/3 ~}%16"
  -- let pat = "{1 ~ ~ ~ ~ ~ ~ 1 0/2 ~ ~ ~ ~ [0 1?]/4 ~ ~ 1?}%16"
  let pat2 = "{0/8 ~ ~ ~ ~ ~ ~ 1? ~ 0 ~ ~ ~ 1/2 ~}%16"
  -- let pat2 = "{~ ~ ~ ~ ~ ~ ~ 0? ~ ~ ~ ~ ~ ~ ~}%16"
  let x = gain pat
  let y = gain (inverse <$> pat)
  let z = gain (inverse <$> pat2)
  d1
    -- $ sometimesBy 0.25 (msvoB 0)
    $ every 13 (0.75<~) . (within (0.25, 0.5) rev)
    $ every 2 (within (0, 0.5) (stutWith "<6 3 5 4>" (1/8) (|* gain (range 0.25 0.85 $ density 1.5 saw))))
    $ every 5 (within (0.5, 1) (stutWith "<2 1 3>" (1/2) (|* sus (range 0.75 0.125 $ density 1.8 sine)) . (rot "<1 -1 0>") . stutB))
    $ stack [
      (x |+ s "cuhh:7" |+ up "{0 -5 -12 7 0 -7}%8" |+ end (range 0.075 0.125 $ slow 1.125 sine) |* gain (range 1.0 0.25 sine))
      , (y |+ s "mbd:9" |+ up "{0 5 -7 3 2}%8" |* sus (range 0.125 1 $ slow 0.635 sine) |* gain (range 0.345 1 saw))
      , (z |+ s "cusn:27" |+ up "{-5 4 -3 -4 2 3}%8" |* sus (range 0.125 0.5 $ slow 1.75 sine))
      ]
    |+ mGain
    |+ slowPanR 3

d2 
  $ mask "t t <t f f> t"
  $ stack[
   (s "txosc(3,8,1)"),
   (s "cul:19(3,8,2)")
   ]
  |+ sus "{0.84 0.75 0.1 1 0.3 0.05 1}%8" 
  |+ accelerate "-0.0333 0.02 -0.04 -0.5" 
  |+ up (scale "hexDorian" "-5 <12 8 -24> 3 5 -8")
  |+ throp "<0 10 0> <3 0> <1 2> <0 8 2>" 
  |+ mGain 
  |+ slowPanR 3
  |+ room 0.3

d3
  $ mask "t f f t"
  $ stutWith "<3 2 4>" (1/4) (|> sus (range 0.1 0.01 $ slow 0.6 sine))
  $ up (scale "hexDorian" "{~ ~ ~ [-2, 5, 7]? ~ [-4, 6, -2] ~ ~ ~ [0, <1 3 4>, 5] ~}%8")
  |+ s "ml3:9"
  |+ sus (range 0.25 0.05 $ slow 1.33 saw)
  |+ room 0.2
  |+ cutoff (range 500 6000 $ slow 2.75 rand)
  |+ slowPanR 3
  |+ shape 0.3
  |+ mGain
  |+ vowel "a u e"

 d1 silence
 
 d3 silence
 
 hush
 
