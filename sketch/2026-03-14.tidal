setcps (132/120/2)

d1
$ slow 8
$ sometimes (off 0.25 (|+| disv "0.0125" "2"))
$ sometimes (striate 3)
$ sound "mpd3:19*4"
|+ n "0 9 2 3"
|+ begin (range 0.125 0.5 sine)
|+ up (slow 3 $ "0 2 -2 -3")
|+ cut "1 3 1 4"
|+ convn "0.2"
|+ mGain


do
   let 
    pat = "{0*2 1 ~ 1/3 ~ ~ [1*4 0/3]/2 ~ ~ 0/4 ~ 1*2 0/3 ~ 1}%16"
    pat2 = "{1 1/4 [1 0] 1 ~ 0/4 1*2 ~ [~ 1*2]/2 ~ 0/3}%16"
   d2
    $ every 4 ((within (0, 0.5)) (msvoB 0)) . (within (0.25, 0.5) (|+ binshfR))
    $ every 9 (within (0.5, 1) (|> mGrav) . (iter 1))
    $ slow 2
    $ sometimes (within (0.5, 0.6) (|+| mfDel' (range 0.1 1 sine)))
    $ sometimesBy 0.25 (off "<0.125 0.75>" (|+| speed "0.3 -0.5 0.75"))
    $ stack [
      mask "t f f t [[f t] [t f f] t]/3" $ gain pat2 |+| sound "mhh:2" |+ cutoff (range 2300 8000 $ slow 3 sine) |+ accelerate "{-0.03 0.05 -0.16 -0.03 0.3 <0 0 0.02 -1.8>}"|+ sus "{0.125 0.2 0.35 0.125 0.08 0.02 0.09}%16"
      , mask "f t t t f t" $ (0.125~>) $ gain pat2 |+| s "mbd2:16" |+ up "{-3 4 -4 2 -4 -5 -7 0 4}%12" |+ accelerate "{0.04 -0.04 -0.4 0.03}"
      , (0.25~>) $ gain pat |+| sound "[moe3 moe1 moe1]/3" |+ up "{<0 -5> 0 8 -3 <8 4 6 -24> -5 4 -2}%12"
      , mask "t [t f]/2 t [t f]" $ gain (inverse <$> pat2) |+| s "~ msn2:13" |+ sus (range 0.25 0.95 $ slow 3 sine)
      ]
      |+ (slow 4 (n "0 20"))
      -- |+| mDefault
      |+ mGain
      |+ slowPanS 4


hush

