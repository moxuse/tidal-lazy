setcps 0.48

d1
  $ slow 6
  $ s "mpd:10(5,12)"
  |+ sus 5
  |+ cutoff (slow 8 (range 800 2800 sine))
  |+ coarse "{2 8 12 4 4}%6"
  |+ squiz "<1 1.25> 1"
  |+ gain "1.1"
  |+ room 0.3
  |+ up (scale "ionian" "[0,5,11] [-2,3 7]*2 [-4 7,17]*2 <0 -5>" + "<0 1 -12 2>/6")


do
  x <- lazy' 4 $ inst0
  d2
    $ (0.3156~>)
    $ every 2 (striate' "<2 3>/2 <12 18>/3" "<0.125 0.05 0.025>") . (|> up "0 2 5 -5 7 -12") . (within (0.25, 0.5) rev)
    $ slow 4
    $ x
    |+ sus "{4 0.2 <0.05 1> 4.85 <1.03 2> 0.25}%8"
    |+ mGain
    |+ slowPanS 0.6
    |+ speed "-0.45 <2 -1> 12 <0.5 0.9>"
    |+ cutoff "<1200 9800 4500 500>/1.75"
    |+ room "0.02 0.1 0.05 0.1"
    -- |+ loop 2
    |+ accelerate "{-0.3 -0.04 0.1 0 -0.2 0}%8"
    |+ room 0.02
    |+ n "5 17 38"

d3
  $ (0.2352~>)
  $ (striate' "4 4 8 6" (range 0.073 0.25 $ sine)) . (|+ up (scale "ionian" "1 -2 3 12 -4 5")) . (|+ sus 0.25)
  $ stut' 4 (1/32) (|* speed 1.1) . (|+ begin (range 0 0.25 $ sine))
  $ slow 6
  $ s "[ml2:4(3,32), mb2:1*2, msn:11(2,5), mbd:2(3,8)]"
  |+ up (scale "ionian" "4 0 5 9 3 -4 7 15" + "2 3 1 7" - "<7 12>")
  |+ sus "{0.04 1 0.125 0.45 0.5 1 2}%8"
  |+ wah 0.03
  |+ mGrav
  |+ slowSpeedR 3
  |+ slowPanR 3

d4 silence
