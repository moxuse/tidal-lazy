setcps (128/120/2)

-- pad at first

do
  let pat = "{0 ~ ~ ~ 0 ~ ~ 0 ~ ~ 1 ~ ~ 1/3 ~ ~}%16"
  let pat2 = "{~ [0*2]/2 ~ <0 0 0*2> ~ 0 ~ ~ 0/2 ~ ~ [0/2 1/3]/4 ~ ~ ~}%16"
  let x = gain pat
  let y = gain (inverse <$> pat)
  let w = gain (inverse <$> pat2)
  let z = gain pat2
  d1 
    -- $ every 2 (superimpose (stutWith "<5 4 3>" ("<3 1 1 2>"/16) (mask "[f f t]*3") . (|+ sus (range 0.45 0.0075 $ slow 0.666 sine)) . (0.125~>) . (|* gain 0.8) . (|+ slowSpeedR 3) . (|+ speed (range 3 0.85 $ slow 1.5 sine) ) . (|+ coarse (range 2 8 saw))))
    -- $ every 9 (within (0, 0.5) (stutWith "<4 3>" ("<1 4 2>"/16) (|+ accelerate (range (0.045) (-0.75) $ slow 1.36 sine)) . (|* gain 0.95) . (|> sus "0.025 0.25 0.03 0.14 0.06 0.08 0.45") . (|+ speed (range (0.93) 1.85 $ slow 0.75 sine) )))
    $ stack [
      (mask "[<t f t f> <f t f f> t]*<12 6>" $ s "mhh:15*16" |+ sus (range 0.25 0.001 $ slow "<0.25 1.25 1>" (rot 2 $ saw)) |+ shape 0.1 |+ gain 1.1)
      , (x |+ s "[msn,mcp:4?]" |+ n 30  |+ shape 0.2 |+ cutoff (range 1400 4200 $ slow 1.65 sine) |+ up "3" |+ coarse "<2 8>" |+ sus 0.65 |* mGain)
      , (y |+ s "mbd2" |+ n 3 |+ gain 0.5)
      , (every 4 (|+ n "2") . (within (0.25,0.5) (jux $ rev)) $ w |+ s "khh:7" |+ sus "<0.25 0.02 0.125 0.05 0.06>*2" |+ up "{-5 -27 -16 24 4}" |+ bpf (range 190 9100 $ slow 1.75 sine) |+ gain 1.1)
      ]
    |+ shape 0.2
    |+ slowPanR 0.333
 
-- bass
d2 
  $ (("<6 10>/2"/16)~>)
  $ mask "[t f] [f f f t]*2 [t f]/2 f"
  $ off (1/8) (off (1/16) ("<0 0.625 0 0.125>"<~) . (|+ up ("<-7 -2 -9>" - 12)))
  $ (0.125~>) $ s "mb:6(3,8)"
  |+ lpf (range 600 4200 $ slow 4.65 sine)
  |+ room 0.2
  |+ sus "2 0.5 1 2 0.6"
  |* sus (range 0.125 0.26 $ slow 2.5 saw)
  |+ up (scale "lydian" "0 4 7" + 12)
  |+ mGain

d3
  $ (("<8 10>/4"/16)~>)
  $ up (scale "aeolian" "[<5 2>/2 <11 [9 10]*2>/2] ~ ~ 0 ~ ~" + 12)
  |+ s "ml5:8"
  -- |+ s "ml:6"
  |+ cutoff (range 1200 600 $ slow 3.753 sine)
  |+ room 0.3
  |+ mGain

-- pad
d4
  $ slow 2
  $ ((26/32)~>)
  $ up (scale "aeolian" "[<-2 ~>/3,4,7,9,<~ 13>/2]" - "<12 17>")
  |+ s "pad2:4"
  |+ cutoff (range 2900 900 $ slow 5.333 sine)
  |+ vowel "o"

-- lead
d5
  $ degradeBy 0.0
  $ up (scale "aeolian" "{~ ~ ~ ~ ~ 0 4 7 13 9 14 18 16 ~ ~}%16" + 4)
  |+ sus (range 0.0125 0.85 $ slow 4 sine)
  |+ s "cul:9"
  |+ shape 0.1
  |+ coarse "<2 4 8>/2"
  |+ mGain
  -- |+ n 4 |* speed 0.80

-- lead2
d5
  $ superimpose (off "<0.75 [0.5 0.75]*2 0.125>" (|+ up "<-5 7 12 17>") . (rev) . (|* sus "<0.5 1.25 0.3 0.125 0.75>"))
  $ up (scale "aeolian" "{~ ~ ~ ~ ~ 0 4 7 13 9 14 18 16 ~ ~}%16" + 4)
  -- $ up (scale "aeolian" "{~ ~ ~ ~ ~ 0 4 7 [~ 13] 9 [~ 17/2] 18 27/2 ~ ~}%16" + 16)
  |+ sus (range 0.0125 0.85 $ slow 4 sine)
  |+ s "cul:9"
  |+ shape 0.1
  |+ coarse "<2 8 [2 <2 8 2 4>]*2 8 2>/3"
  -- |+ n 4 |* speed 0.80
  |+ gain 1.3

do
  d1 silence
  d3 silence
  d5 silence

d2 silence
