setcps (136/120/2)

do
  let pat = "{0 1/2 0/4 ~ ~ [1 0?]/2 ~ ~ 0 ~ ~ 1/2 0 ~ <1 0 ~ 1> <1 ~ 1 0>}%16"
  let pat2 = "{~ 1? 0/4 ~ ~ ~ <1 ~> <~ ~ 1> ~ ~ ~ ~ ~ 1/3 0/2 ~}%16"
  let x = gain pat
  let y = gain (inverse <$> pat)
  let z = gain pat2
  let w = gain (inverse <$> pat2)
  d1
    -- $ mask (slow 2 $ "t t t f")
    $ every 4 (rot 1) . (jux rev) . (|+ room "0 0 0.01 <0 0.1> 0 0 0")
    $ every 7 (within (0.25,0.75) (stutWith "<3 4 5>" (1/16) (|+ begin (range 0.01 0.99 sine))))
    $ every 5 (within (0.5,1) (stutWith "<7 2 3>" (1/16) (|* sus (range 0.25 0.75 $ slow 0.33 sine))))
    $ every 11 (within (0.125,0.5) (stutWith "<2 2 3>" (1/4) (jux (iter (-1))) . (|+ mfDel' 0.3)))
    $ stack [
      (x |+ s "mbd:17" |+ sus (range 0.05 0.25 $ slow 3 saw) |+ up "{-14 0 2 -8 -4 -12}")
      , (y |+ s "mhh:9" |+ sus 0.01 |+ up "0 24 5 3 12" |+ accelerate (range 0.3 (-0.04) $ slow 3.5 sine))
      , (z |+ s "msn2:1" |+ sus (range 0.015 0.075 $ slow 0.65 sine) |+ up "7 5 3 -4 12" |+ n "<0 4 10 1>/2")
      , (w |+ s "msn:16" |+ sus (range 0.25 0.075 $ slow 0.65 sine) |+ up "{-7 <24 -15> -23 <-6 -4> <15 -12>}")
    ] 
    -- |+ cutoff (range 1200 12000 $ slow 4 saw)
    |+ mGain
    |+ slowPanR 3

d2
$ slow 4 
$ every 3 (0.25<~)
$ stack [
  -- (s "mnz:14(2,8)" |+ accelerate "<-0.3 0.63 -0.5>/2")
  (s "msoz:9(<2 3>,8)" |+ wah 0.02)
  , ((0.125~>) $ s "mnz:24(2,8)" |> sus 1.75 |+ speed "<0.65 0.45>/2" |> cutoff 1230 |+ vowel "<a e i>" |+ n "<0 -3>/4")
]
|+ sus (range 0.35 0.65 $ slow 3 saw)
|+ up "<-1 4 -5 -3>"
|+ cutoff (range 400 4500 $ slow 2.75 sine)
|+ dist 0.08
|+ slowPanR 4
|+ begin (range 0.125 0.66 $ slow 3 sine)
|+ speed (-0.35)
|+ room 0.2
|+ mGain

d3
$ stack [
  (every 4 (0.125<~) $ mask "<t t t f> t <f t> t" $ 
every 5 (rot (-1)) $ up (scale "hexDorian" "<[~ 6] -1 -5> ~ [~ 3] <~ [~ 7] <3 1 9 11>>" + "<0 5>") |+ s "mb:18")
  , (up (scale "hexDorian" "<0 ~> [~ ~ ~ <~ <-2 -3?>>]") |> sus 0.075 |+ s "mb:18")
  ]
|+ cutoff (range 220 3440 $ slow 2 sine)
|+ shape 0.3
|+ dist (range 0.1 0.05 $ slow 2.75 sine)
|+ sus (range 0.5 0.25 $ slow 1.25 sine)
|+ mGain

-- pad
d5
$ slow 2
$ s "msoz:14(2,8)"
-- |+ up (scale "hexDorian" "[0,2,5]") |+ gain 0.9
|* speed "<0.4 0.4 0.46 0.479>"
|+ begin "[0.7 0.3 0.5 0.24 0.1]*2"
|+ cutoff 600
|+ sus 2
|+ shape 0.3
|+ room 0.15

-- short ld
d5
$ mask (slow 2 $ "t t t [[<f f f t> f] f f f]")
$ s "ml2:31*16"
|+ up (scale "hexDorian" "[-6,0,5,14,23]" + "<0 12 -12 7>/2") |+ gain 1.2
|+ cutoff (range 1020 4800 $ slow 7.33 rand)
|+ sus (range 0.088 0.025 $ slow 11.5 sine)
|+ convn 0.2
|+ dist (range 0.2 0.4 $ slow 4.5 sine)
|+ shape 0.25
|+ room "0 0 0 <0 0.3> 0 0"
-- |+ n 21

d7 silence

-- surge with Mox-4*
d9 $ degradeBy 0.25 $ slow 2 $ every 2 (stutWith "<3 5 6>" (1/9) (|+ sus (range 0.12 0.46 sine)))  
$ n (scale "hexDorian" "0 ~ [4 -5/2, 9] 7 ~ ~ [0, 5]/2 ~ ~ ~" - "<21 7 12>") |+ s "[midiout]" |+ midichan 0 |* sus "0.5 0.1 0.75 0.8"

d6 $ s "midiout*24" |+ ccv (range 26 88 $ density "0.75 [0.75 1.25] [2 0.25 0.1]/3 0.1 0.04" saw) |+ ccn 1 |+ midichan 0

d8 $ s "midiout*16" |+ ccv (range 47 83 $ density "0.25 [0.3 [3 0.4 0.3]/3] 1.25 0.05" $ slow 4 saw) |+ ccn 2 |+ midichan 0

d4 $ s "midiout*16 midiout*10" |+ ccv (range 23 97 $ density "0.33 [0.25 2 <5 0.1 0.4>]/3 [3 0.25 0.25]" $ slow 3 sine) |+ ccn 3 |+ midichan 0

d9 silence


hush

