setcps (132/120/2)

-- d9 gutar pad at first

do
  let bass = up (scale "hexDorian" "6 ~ ~ ~ <12? ~ 3 5> ~ ~ ~ ~ <~ 4 ~ 6> ~ 3 <0 ~ ~ -3> <~ 0 9> ~ ~ 0? ~ ~ ~ ~" - "<6 4>/4") |+ s "cub:30" |+ mGain |> speed (0.25) |+ sus "{0.45 0.125 0.5 0.075 0.05 <0.75 0.125> 0.075 0.25}%8" |* gain "0.49 0.25 0.45 0.125 0.45 0.8 0.5 1 0.8"
  let layer = (s "<ml6:5? ml6:25>") |+ up (scale "hexDorian" "[0,3,9,12,24]" - "<6 4>/4") |+ cutoff (slow 7 $ range 800 15000 sine) |+ speed (-1)
  -- let layer = (s "<ml:25>") |+ up (scale "hexDorian" "[0,3,9,12,24]" - "<6 4>/4") |+ cutoff (slow 7 $ range 2800 15000 sine) |+ speed (-1)
  -- x <- lazy'' "tff t(4,9)" $ inst $ bd "mbd2:23" . sn "[zap/2, ml4:8?]"
  x <- lazy' 2 $ inst $ bd "mbd2:7" . sn "[zap:31/2, ml4:8?]" . cp "mcp:1"
  d1
    $ every 4 (within (0.5, 0.75) (stutWith "<3 5 6>" (1/16) (|* gain (range 1.1 0.75 sine)) . (|+ accelerate (range 0.03 (-0.7) sine))))
    $ degradeBy 0.65
    $ unison "mbd2" layer
    $ every 2 (msvoB 0)
    $ sometimesBy 0.2 (within (0, 0.75) (striate 3))
    $ stack [
        (degradeBy 0.1 $ x |+ slowSpeedR 4 |+ nudge (-0.0125))
        ,bass
     ]
    |+ coarse "{2 2 4 8 12 2}%8"
    |+ mGain
    |+ speed 1.5
    |+ slowPanS 3
    |+ room 0.015
    |+ n "12 26"
    -- |+ n 12

do
  let pat = "{~ 0 1/2 ~ ~ [1 0?]/2 ~ ~ 1 ~ ~ ~ 1/2 0 <1 0 ~ 1> <1 ~ 1 0>}%16"
  let x = gain pat
  let y = gain (inverse <$> pat)
  d2
    $ every 4 (rot 1) . (jux rev) . (|+ room "0 0 0.01 <0 0.1> 0 0 0")
    $ every 7 (within (0.25,0.75) (stutWith "<3 4 5>" (1/16) (|+ begin (range 0.01 0.99 sine))))
    $ every 5 (within (0.5,1) (stutWith "<7 2 3>" (1/16) (|* sus (range 0.25 0.75 $ slow 0.33 sine))))
    $ every 3 (within (0,0.5) (|+ mfDel' "0.02 0.3 0 0.4 0.5 0.2 0 0.6"))
    $ stack [
      (x |+ s "mhh:2" |+ up "0 24 5 13 12" |+ accelerate (range 0.3 (-0.04) $ slow 3.5 sine))
    ] 
    |+ cutoff (range 2200 12000 $ slow 4 saw)
    |* gain "[0.65 1 0.74]*2 [0.125 0.8]*2 [0.5 0.75]*2 [0.35 0.9 0.5]*2"
    |+ sus (range 0.075 0.005 $ slow 6.33 sine)
    |+ gain 1.1
    |+ slowPanS 1.1256
    |+ orbit 1

d1 silence

-- surge with Mox-bass-0*
d9 $ degradeBy 0.35 $ every 2 (stutWith "<3 5 6>" (1/8) (|+ sus (range 0.12 0.46 sine)))  
$ n (scale "hexDorian" "0 ~ [4 -5/2, 9] 7 ~ ~ [0, 5]/2 ~ 9 ~" - "<21 7 12>") |+ s "[midiout]" |+ midichan 0 |* sus "{0.5 0.1 1 0.75 0.8}"

d7 $ s "midiout*24" |+ ccv (range 26 78 $ density "0.75 [0.75 1.25] [2 0.25 0.1]/3 0.1 0.04" saw) |+ ccn 1 |+ midichan 0

d8 $ s "midiout*16" |+ ccv (range 47 83 $ density "0.25 [0.3 [3 0.4 0.3]/3] 1.25 0.05" $ slow 4 saw) |+ ccn 2 |+ midichan 0

d4 $ s "midiout*16 midiout*10" |+ ccv (range 23 77 $ density "0.33 [0.25 2 <5 0.1 0.4>]/3 [3 0.25 0.25]" $ slow 3 sine) |+ ccn 3 |+ midichan 0


-- Mox-SF-0*
do
  d7 silence
  d8 silence
  d4 silence
  d9
    $ slow 2
    $ mask "t [t <f f t> <f t> <f f t f>] t [<t f f> f]"
    $ off "<0.125 0.25 0.375 0.5 0.75>" (|+ up "<5 21 7 9>") . (rot "<0 1 2 3>")
    $ n (scale "hexDorian" "~ 14/4 ~ ~ ~ ~ 3 ~ [~ 0 ~ <-5 -1>] ~ ~ ~ [0 9 ~ 3] ~ ~ ~" - 5)
    |+ sus "0.45 0.75 0.05 0.56 0.75 1"
    |+ s "midiout"
    |+ midichan 0

d6
$ slow 2
$ mask "t <t f t> t <f f t>"
$ (superimpose (every 2 (off "<0.625 0.35 0.75 0.125>" (|+ up "<7 19>") . (|+ sus 0.075))))
$ up (scale "hexDorian" (degradeBy 0.125 $ "{[0 4 6, 8 9] <0 5> ~ ~ ~ [0 8, 5 7]/2 -3 ~ ~ 5/2 <-12 -9> 6 ~ ~ ~}" - "<4 2>/4"))
|+ s "ml4:10"
|+ delayt "{0.1 0.05 0 0.14 0.28 0.3 0.08}"
|+ coarse 8
|+ hpf 120
|+ shape 0.2
|+ cutoff (range 1200 3600 $ slow 5.33 sine)
|+ delayfeedback 0.45
|+ slowPanR 4
|+ delay 0.75
|+ room 0.3
|+ gain 0.75

d5
$ up (scale "hexDorian" "{[3, 4 9] 0 [0, 2/2, <3 5>] ~ ~ <~ ~ 5> ~ ~ ~ <~ 0> ~ [6, 9, 17?] ~}%8" - "-2")
|+ s "ml3:10"
|+ cutoff (range 1200 2200 $ slow 4 sine)
|+ coarse 2
|+ speed "{4 2 1 4 2 2 4}"
|+ sus (range 0.16 0.25 $ slow 3 sine)
|+ gain 1.1

d9 silence

d2 silence

